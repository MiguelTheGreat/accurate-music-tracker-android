<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Layer 1: Directional hairline Fresnel specular rim (top-left catchlight -> bottom-right bounce) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="315"
                android:startColor="#D9FFFFFF"
                android:centerColor="#330F172A"
                android:endColor="#400F172A" />
        </shape>
    </item>

    <!-- Layer 2: Translucent Liquid Glass body (wallpaper shows softly through) -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="23dp" />
            <gradient
                android:angle="270"
                android:startColor="#B8FFFFFF"
                android:endColor="#99EDF2FA" />
        </shape>
    </item>

    <!-- Layer 3: Whisper-soft top ambient glass sheen -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="23dp" />
            <gradient
                android:angle="270"
                android:startColor="#40FFFFFF"
                android:centerColor="#0AFFFFFF"
                android:centerY="0.32"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
