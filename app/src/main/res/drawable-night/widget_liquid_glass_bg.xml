<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Layer 1: Directional hairline Fresnel specular rim (top-left catchlight -> bottom-right bounce) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="315"
                android:startColor="#59FFFFFF"
                android:centerColor="#1AFFFFFF"
                android:endColor="#33FFFFFF" />
        </shape>
    </item>

    <!-- Layer 2: Deep translucent Liquid Glass body (eye-friendly dark glass over wallpaper) -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="23dp" />
            <gradient
                android:angle="270"
                android:startColor="#A8131826"
                android:endColor="#990B0E17" />
        </shape>
    </item>

    <!-- Layer 3: Whisper-soft top ambient glass sheen (no milky fog) -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="23dp" />
            <gradient
                android:angle="270"
                android:startColor="#12FFFFFF"
                android:centerColor="#03FFFFFF"
                android:centerY="0.30"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
